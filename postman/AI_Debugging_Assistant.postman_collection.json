                  "});",
                  "",
                  "pm.test(\"Each history item has required fields\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    jsonData.forEach(function(item) {",
                  "        pm.expect(item).to.have.property(\"code\").that.is.a(\"string\");",
                  "        pm.expect(item).to.have.property(\"error\").that.is.a(\"string\");",
                  "        pm.expect(item).to.have.property(\"result\").that.is.an(\"object\");",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"Returns 10 or fewer items by default\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.length).to.be.at.most(10);",
                  "});"
