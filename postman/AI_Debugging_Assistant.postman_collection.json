    {
      "name": "Debug Endpoint",
      "item": [
        {
          "name": "Debug Code - Valid Input",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has language field\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"language\");",
                  "    pm.expect(jsonData.language).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "",
                  "pm.test(\"Response has primary_issue with all required fields\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"primary_issue\");",
                  "    pm.expect(jsonData.primary_issue).to.have.property(\"error_explanation\").that.is.a(\"string\").and.not.empty;",
                  "    pm.expect(jsonData.primary_issue).to.have.property(\"root_cause\").that.is.a(\"string\").and.not.empty;",
                  "    pm.expect(jsonData.primary_issue).to.have.property(\"fix\").that.is.a(\"string\").and.not.empty;",
                  "    pm.expect(jsonData.primary_issue).to.have.property(\"severity\").that.is.a(\"string\").and.not.empty;",
                  "});",
                  "",
                  "pm.test(\"Response has additional_issues as an array\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"additional_issues\");",
                  "    pm.expect(jsonData.additional_issues).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"Each additional issue has all required fields\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    jsonData.additional_issues.forEach(function(issue) {",
                  "        pm.expect(issue).to.have.property(\"issue\").that.is.a(\"string\");",
                  "        pm.expect(issue).to.have.property(\"explanation\").that.is.a(\"string\");",
                  "        pm.expect(issue).to.have.property(\"fix\").that.is.a(\"string\");",
                  "        pm.expect(issue).to.have.property(\"severity\").that.is.a(\"string\");",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"Response has confidence_score\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"confidence_score\");",
                  "    pm.expect(jsonData.confidence_score).to.be.a(\"string\").and.not.empty;",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"const data = null; data.map(x => x + 1);\",\n  \"error\": \"TypeError: cannot read property 'map' of undefined\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/debug",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "debug"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Debug Code - Missing Required Fields (Negative Test)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Returns 422 for missing required fields\", function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "",
                  "pm.test(\"Response contains validation error detail\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"detail\");",
                  "    pm.expect(jsonData.detail).to.be.an(\"array\").and.not.empty;",
                  "});",
                  "",
                  "pm.test(\"Error mentions missing fields\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var fields = jsonData.detail.map(e => e.loc).flat();",
                  "    pm.expect(fields).to.include(\"code\");",
                  "    pm.expect(fields).to.include(\"error\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
